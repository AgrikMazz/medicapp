GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_2=openai/gpt-oss-20b
GROQ_MODEL_3=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=512

ANSWER_CONTEXT_CHAR_LIMIT=24000
ANSWER_CONTEXT_TOKEN_BUDGET=4096
GROQ_MIN_REQUEST_INTERVAL_SECONDS=2.2

RETRIEVAL_METHOD=hnsw_ppr_crossencoder
HNSW_INDEX_PATH=data/hnsw_index.bin
RETRIEVAL_HNSW_CANDIDATES=20
RETRIEVAL_RERANK_CANDIDATES=40
GRAPH_RETRIEVAL_EXPAND_K=20
GRAPH_RETRIEVAL_PPR_ALPHA=0.5
RAG_CONTEXT_TOKENIZER=openai/gpt-oss-20b
